{
  "name": "nmatei.github.io",
  "version": "1.0.0",
  "description": "Nicolae Matei website",
  "main": "functions.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "clear": "rimraf node_modules",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "browser-sync start --config js/bs-config.js",
    "coupon": "node js/add-coupon.js web.html",
    "c": "yarn coupon",
    "postcoupon": "prettier --write web.html ro/web.html course/coupons.json && npm run deploy",
    "--deploy": "echo \"Pls deploy changes manualy...\"",
    "deploy": "git add web.html ro/web.html course/ && git status && git commit -m \"add coupon\" && git push origin HEAD",
    "build": "node js/add-coupon.js web.html clean old && prettier --write web.html ro/web.html"
  },
  "keywords": [
    "nmatei",
    "web",
    "js",
    "css",
    "html",
    "study",
    "programming",
    "course"
  ],
  "author": "Nicolae Matei",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "browser-sync": "^3.0.2"
  }
}
